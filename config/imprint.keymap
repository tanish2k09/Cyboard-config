#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &physical_layout_imprint_number_row_full_bottom_row; };

    macros {
        LockMacOS: LockMacOS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(Q))>;
            label = "LOCKMACOS";
        };

        MacOS: MacOS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "MACOS";
        };

        PC: PC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "PC";
        };
    };

    behaviors {
        Bck_Del: Bck_Del {
            compatible = "zmk,behavior-mod-morph";
            label = "BCK_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    // Hold Nav (3) and Sym (4) together to reach System (5).
    // Don't reorder layers in ZMK Studio, or this will point at the wrong ones.
    conditional_layers {
        compatible = "zmk,conditional-layers";

        system_layer {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "PC";
            bindings = <
&kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp RGUI
&kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSLH
&kp ESC    &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
&kp LCTRL  &kp LGUI   &kp LALT   &none      &trans                           &trans     &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT
                                            &kp SPACE  &kp LCTRL  &kp LALT   &kp RET    &sk RSHFT  &mo 6
                                            &kp LGUI   &mo 3      &mo 4      &Bck_Del   &mo 4      &mo 3
            >;
        };

        Mac {
            display-name = "Mac";
            bindings = <
&kp GRAVE   &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &LockMacOS
&kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BSLH
&kp ESC     &kp A       &kp S       &kp D       &kp F       &kp G       &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT
&kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B       &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp RSHFT
&kp LCTRL   &kp LALT    &kp LGUI    &none       &trans                              &trans      &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT
                                                &kp SPACE   &kp LGUI    &kp LALT    &kp RET     &sk RSHFT   &mo 6
                                                &kp LCTRL   &mo 3       &mo 4       &Bck_Del    &mo 4       &mo 3
            >;
        };

        Gaming {
            display-name = "Gaming";
            bindings = <
&kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp RGUI
&kp TAB    &kp T      &kp Q      &kp W      &kp E      &kp R      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSLH
&kp ESC    &kp G      &kp A      &kp S      &kp D      &kp F      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp Z      &kp LSHFT  &kp X      &kp C      &kp C      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
&kp LCTRL  &kp LGUI   &kp LALT   &tog 2     &trans                           &trans     &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT
                                            &kp SPACE  &kp LCTRL  &kp LALT   &kp RET    &kp RSHFT  &kp RCTRL
                                            &kp V      &mo 3      &mo 4      &Bck_Del   &mo 4      &mo 3
            >;
        };

        Navigation {
            display-name = "Nav";
            bindings = <
&trans           &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6           &kp F7           &kp F8           &kp F9           &kp F10          &kp F11
&trans           &kp PAUSE_BREAK  &kp SCRLK       kp SLCK         &kp CAPS         &kp DEL          &kp K_APP        &kp C_RW         &none            &none            &kp C_FF         &kp PSCRN        &kp F12
&trans           &kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none            &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &none            &trans
&kp CAPS         &none            &none            &none            &none            &none            &kp HOME         &kp PG_DN        &kp PG_UP        &kp END          &kp INS          &kp CAPS
&trans           &trans           &trans           &none            &trans                                             &trans           &kp C_MUTE       &kp C_VOL_DN     &kp C_VOL_UP     &trans
                                                                    &trans           &trans           &trans           &kp C_PP         &kp C_PREV       &none
                                                                    &trans           &trans           &trans           &kp C_NEXT       &trans           &none
            >;
        };

        Symbols {
            display-name = "Sym";
            bindings = <
&kp LS(GRAVE)  &kp LS(N1)     &kp LS(N2)     &kp LS(N3)     &kp LS(N4)     &kp LS(N5)     &kp LS(N6)     &kp LS(N7)     &kp LS(N8)     &kp LS(N9)     &kp LS(N0)     &trans
&kp GRAVE      &kp LS(N7)     &kp LS(EQUAL)  &kp LBKT       &kp RBKT       &kp LS(BSLH)   &trans         &kp N7         &kp N8         &kp N9         &kp LS(GRAVE)  &kp LS(BSLH)
&trans         &kp LS(N1)     &kp EQUAL      &kp LS(N9)     &kp LS(N0)     &kp MINUS      &trans         &kp N4         &kp N5         &kp N6         &kp LS(SEMI)   &kp LS(SQT)
&kp CAPS       &kp LS(N8)     &kp LS(COMMA)  &kp LS(LBKT)   &kp LS(RBKT)   &kp LS(DOT)    &trans         &kp N1         &kp N2         &kp N3         &kp LS(FSLH)   &kp CAPS
&trans         &trans         &trans         &trans         &trans                                       &trans         &kp N0         &trans         &trans         &trans
                                                            &kp LS(MINUS)  &trans         &trans         &trans         &trans         &trans
                                                            &trans         &trans         &trans         &trans         &trans         &trans
            >;
        };

        System {
            display-name = "System";
            bindings = <
&none         &PC           &MacOS        &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none         &none         &none         &none         &none         &bt BT_CLR
&sys_reset    &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &sys_reset
&bootloader   &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &bootloader
&none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
&to 0         &to 1         &tog 2        &tog 2        &none                                     &none         &none         &none         &none         &none
                                                        &trans        &trans        &trans        &trans        &trans        &trans
                                                        &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
&trans           &trans           &trans           &mmv MOVE_UP     &msc SCRL_UP     &trans           &trans           &trans           &trans           &trans           &trans           &trans
&trans           &trans           &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_RIGHT  &trans           &mkp MB4         &mkp LCLK        &mkp MCLK        &mkp RCLK        &mkp MB5         &trans
&trans           &trans           &trans           &trans           &msc SCRL_DOWN   &trans           &trans           &trans           &trans           &trans           &trans           &trans
&trans           &trans           &trans           &trans           &trans                                             &trans           &trans           &trans           &trans           &trans
                                                                    &trans           &trans           &trans           &trans           &trans           &trans
                                                                    &trans           &trans           &trans           &trans           &trans           &trans
            >;
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};

// Tuning for built-in behaviors, so they work well when assigned in ZMK Studio.
// Sticky keys release as soon as the next key is pressed (no double capitals).
&sk {
    quick-release;
};

// Layer-tap and mod-tap: resist misfires during fast typing.
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

// right hand trackball configuration
// &trackball_peripheral_listener {
//    input-processors =
//     activate layer 3 within 500ms of the trackball moving
//     <&zip_temp_layer 3 500>;
// };
//left hand trackball configuration

&trackball_central_listener {
    input-processors =
        // multiply sensitivity by 1, divide by 3 (make it slower for scrolling),,,,,,,,,,,,,,,,,,,,,,,,
        <&zip_xy_scaler 1 3>,
        // make this trackball output scrolling events by default instead of cursor movement,,,,,,,,,,,,,,,,,,,,,,,,
        <&zip_xy_to_scroll_mapper>,
        // invert vertical scrolling so that the view moves in the same direction as the top of the trackball.,,,,,,,,,,,,,,,,,,,,,,,,
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
};
