#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,physical-layout = &physical_layout_imprint_number_row_full_bottom_row; };

    macros {
        LockMacOS: LockMacOS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(Q))>;
            label = "LOCKMACOS";
        };

        MacOS: MacOS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "MACOS";
        };

        PC: PC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "PC";
        };
    };

    behaviors {
        Bck_Del: Bck_Del {
            compatible = "zmk,behavior-mod-morph";
            label = "BCK_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    // Hold Nav (3) and Sym (4) together to reach System (5).
    // Don't reorder layers in ZMK Studio, or this will point at the wrong ones.
    conditional_layers {
        compatible = "zmk,conditional-layers";

        system_layer {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "PC";
            bindings = <
&kp GRAVE   &kp N1    &kp N2        &kp N3  &kp N4            &kp N5                            &kp N6     &kp N7           &kp N8          &kp N9          &kp N0        &kp RIGHT_GUI
&kp TAB     &kp Q     &kp W         &kp E   &kp R             &kp T                             &kp Y      &kp U            &kp I           &kp O           &kp P         &kp BSLH
&kp ESCAPE  &kp A     &kp S         &kp D   &kp F             &kp G                             &kp H      &kp J            &kp K           &kp L           &kp SEMI      &kp SQT
&kp LSHFT   &kp Z     &kp X         &kp C   &kp V             &kp B                             &kp N      &kp M            &kp COMMA       &kp DOT         &kp FSLH      &kp RSHFT
&kp LCTRL   &kp LCMD  &kp LEFT_ALT  &none   &trans                                                         &trans           &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
                                            &kp SPACE         &kp LEFT_CONTROL  &kp LEFT_ALT    &kp ENTER  &kp RIGHT_SHIFT  &kp RCTRL
                                            &kp LEFT_COMMAND  &mo 3             &mo 4           &Bck_Del   &mo 4            &mo 3
            >;
        };

        Mac {
            display-name = "Mac";
            bindings = <
&kp GRAVE   &kp N1        &kp N2        &kp N3  &kp N4            &kp N5                            &kp N6     &kp N7           &kp N8          &kp N9          &kp N0        &LockMacOS
&kp TAB     &kp Q         &kp W         &kp E   &kp R             &kp T                             &kp Y      &kp U            &kp I           &kp O           &kp P         &kp BSLH
&kp ESCAPE  &kp A         &kp S         &kp D   &kp F             &kp G                             &kp H      &kp J            &kp K           &kp L           &kp SEMI      &kp SQT
&kp LSHFT   &kp Z         &kp X         &kp C   &kp V             &kp B                             &kp N      &kp M            &kp COMMA       &kp DOT         &kp FSLH      &kp RSHFT
&kp LCTRL   &kp LEFT_ALT  &kp LEFT_GUI  &none   &trans                                                         &trans           &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
                                                &kp SPACE         &kp LEFT_COMMAND  &kp LEFT_ALT    &kp ENTER  &kp RIGHT_SHIFT  &kp RCTRL
                                                &kp LEFT_CONTROL  &mo 3             &mo 4           &Bck_Del   &mo 4            &mo 3
            >;
        };

        Gaming {
            display-name = "Gaming";
            bindings = <
&kp GRAVE   &kp N1          &kp N2        &kp N3  &kp N4     &kp N5                            &kp N6     &kp N7      &kp N8          &kp N9          &kp N0        &kp RGUI
&kp TAB     &kp T           &kp Q         &kp W   &kp E      &kp R                             &kp Y      &kp U       &kp I           &kp O           &kp P         &kp BSLH
&kp ESCAPE  &kp G           &kp A         &kp S   &kp D      &kp F                             &kp H      &kp J       &kp K           &kp L           &kp SEMI      &kp SQT
&kp Z       &kp LEFT_SHIFT  &kp X         &kp C   &kp C      &kp B                             &kp N      &kp M       &kp COMMA       &kp DOT         &kp FSLH      &kp RSHFT
&kp LCTRL   &kp LEFT_GUI    &kp LEFT_ALT  &tog 2  &trans                                                  &trans      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
                                                  &kp SPACE  &kp LEFT_CONTROL  &kp LEFT_ALT    &kp ENTER  &kp RSHIFT  &kp RCTRL
                                                  &kp V      &mo 3             &mo 4           &Bck_Del   &mo 4       &mo 3
            >;
        };

        Navigation {
            display-name = "Nav";
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &none  &none  &none  &none  &none  &none  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp PRINTSCREEN  &kp F12
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &caps_word  &trans
&trans  &none  &none  &none  &none  &none  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END  &kp INSERT  &trans
&trans  &trans  &trans  &none  &trans  &kp C_REWIND  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_FAST_FORWARD
&trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Symbols {
            display-name = "Sym";
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&kp GRAVE  &kp AMPERSAND  &kp PLUS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PIPE  &trans  &kp AT_SIGN  &kp PERCENT  &kp CARET  &kp TILDE  &trans
&trans  &kp EXCLAMATION  &kp EQUAL  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS  &trans  &kp LESS_THAN  &kp GREATER_THAN  &kp COLON  &kp DOUBLE_QUOTES  &trans
&trans  &kp DOLLAR  &kp ASTERISK  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp HASH  &trans  &kp BACKSLASH  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp UNDERSCORE  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        System {
            display-name = "System";
            bindings = <
&none  &PC  &MacOS  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &none  &none  &none  &none  &bt BT_CLR
&sys_reset  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &sys_reset
&bootloader  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &bootloader
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&to 0  &to 1  &tog 2  &none  &none  &none  &none  &none  &none  &none
&trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};

// right hand trackball configuration
// &trackball_peripheral_listener {
//    input-processors =
//     activate layer 3 within 500ms of the trackball moving
//     <&zip_temp_layer 3 500>;
// };
//left hand trackball configuration

&trackball_central_listener {
    input-processors =
        // multiply sensitivity by 1, divide by 3 (make it slower for scrolling),,,,,,,,,,,,,,,,,,,,,,,,
        <&zip_xy_scaler 1 3>,
        // make this trackball output scrolling events by default instead of cursor movement,,,,,,,,,,,,,,,,,,,,,,,,
        <&zip_xy_to_scroll_mapper>,
        // invert vertical scrolling so that the view moves in the same direction as the top of the trackball.,,,,,,,,,,,,,,,,,,,,,,,,
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
};
